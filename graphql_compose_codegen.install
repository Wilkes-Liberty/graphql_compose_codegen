<?php

/**
 * @file
 * Install and requirements hooks for graphql_compose_codegen.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\graphql_compose_codegen\Hook\GraphqlComposeCodegenHooks;
use Drupal\graphql_compose_codegen\Service\ArtefactSnapshot;

/**
 * Implements hook_requirements().
 *
 * Reported at Administration » Reports » Status report (runtime phase).
 *
 * This is the Drupal 10 compatibility bridge. Drupal 11.3+ skips it and uses
 * GraphqlComposeCodegenHooks::runtimeRequirements() instead.
 */
#[LegacyRequirementsHook]
function graphql_compose_codegen_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  return \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->runtimeRequirements();
}

/**
 * Implements hook_uninstall().
 *
 * hook_uninstall cannot be an attribute hook (Drupal core deny list).
 * Config is removed on uninstall; State is not. Leftover snapshot hashes
 * would make gqcc:diff inherit the previous enablement.
 */
function graphql_compose_codegen_uninstall(): void {
  \Drupal::state()->delete(ArtefactSnapshot::STATE_KEY);
}
