<?php

/**
 * @file
 * Legacy hook bridges for graphql_compose_codegen.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\field\FieldConfigInterface;
use Drupal\graphql_compose_codegen\Hook\GraphqlComposeCodegenHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function graphql_compose_codegen_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->help($route_name, $route_match);
}

/**
 * Implements hook_entity_bundle_create().
 */
#[LegacyHook]
function graphql_compose_codegen_entity_bundle_create(string $entity_type_id, string $bundle): void {
  \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->entityBundleCreate($entity_type_id, $bundle);
}

/**
 * Implements hook_entity_bundle_delete().
 */
#[LegacyHook]
function graphql_compose_codegen_entity_bundle_delete(string $entity_type_id, string $bundle): void {
  \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->entityBundleDelete($entity_type_id, $bundle);
}

/**
 * Implements hook_field_config_insert().
 */
#[LegacyHook]
function graphql_compose_codegen_field_config_insert(FieldConfigInterface $field_config): void {
  \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->fieldConfigInsert($field_config);
}

/**
 * Implements hook_field_config_delete().
 */
#[LegacyHook]
function graphql_compose_codegen_field_config_delete(FieldConfigInterface $field_config): void {
  \Drupal::service(GraphqlComposeCodegenHooks::class)
    ->fieldConfigDelete($field_config);
}
