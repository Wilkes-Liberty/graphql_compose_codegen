{
    "name": "drupal/graphql_compose_codegen",
    "description": "Drush-powered TypeScript and GraphQL scaffold generator for Next.js frontends driven by graphql_compose.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/graphql_compose_codegen",
    "keywords": [
        "drupal",
        "graphql",
        "graphql-compose",
        "codegen",
        "nextjs",
        "typescript",
        "react",
        "headless"
    ],
    "authors": [
        {
            "name": "Jeremy Cerda",
            "email": "jmcerda@wilkesliberty.com",
            "homepage": "https://www.drupal.org/u/jmcerda",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/graphql_compose_codegen",
        "source": "https://git.drupalcode.org/project/graphql_compose_codegen"
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10.2 || ^11",
        "drupal/graphql_compose": "^2.1",
        "drush/drush": "^12 || ^13"
    },
    "require-dev": {
        "drupal/core-dev": "^10.2 || ^11"
    },
    "suggest": {
        "drupal/scheduler": "Exposes publish_on / unpublish_on fields that gqcc:inspect will type-map automatically.",
        "drupal/paragraphs": "Enables paragraph-bundle introspection and fragment generation."
    }
}
