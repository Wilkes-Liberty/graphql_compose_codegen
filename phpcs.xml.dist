<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="graphql_compose_codegen">
  <description>PHP_CodeSniffer configuration for graphql_compose_codegen.</description>

  <arg name="extensions" value="php,module,install,inc,profile,theme"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <file>src/</file>
  <file>tests/</file>
  <file>graphql_compose_codegen.module</file>
  <file>graphql_compose_codegen.install</file>
  <file>graphql_compose_codegen.api.php</file>
  <file>modules/graphql_compose_codegen_mcp/</file>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
